# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fleet_dev

# JWT signing secret (use a strong random string in production)
JWT_SECRET_KEY=

# Token expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins (CORS).
# Local dev default: http://localhost:5173,http://127.0.0.1:5173
# In production add your deployed frontend URL(s), e.g.
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=
